# The Process scope: what the dashboard's one Process receives (deploy-kit, spec/v1,
# chapter 10, Configuration). Literals are literal; a derived value is a named placeholder.

# --- the project's database (internal/platform/pg): where it answers, and the login the edge to
#     platform-postgres derives, which the Secret Store issues and rotates
PGHOST=${dependency:platform-postgres.host}
PGPORT=${dependency:platform-postgres.port}
PGDATABASE=estate-dashboard_db
PGSSLMODE=disable
PGUSER=${dependency:platform-postgres.username}
PGPASSWORD=${dependency:platform-postgres.password}

# --- Alertmanager, read and silenced (internal/alerts). A literal until a Project declares it (#11).
ALERTMANAGER_URL=http://metrics-stack-alertmanager.observability.svc.cluster.local:9093

# --- signing in through auth (cmd/estate-dashboard). OIDC_CLIENT_ID is left to its default,
#     estate-dashboard, the client auth registered. The redirect is the one registered for it.
OIDC_ISSUER=${exposure:auth.public#url}
OIDC_REDIRECT_URL=${exposure:estate-dashboard.public#url}/auth/callback
OIDC_CLIENT_SECRET=${secret:secret/data/estate-dashboard-system/sign-in#oidc-client-secret}
SESSION_KEY=${secret:secret/data/estate-dashboard-system/sign-in#session-key}

# --- Loki, for each container's logs (internal/logs). A literal until a Project declares Loki; the
#     observability namespace runs it on the old path and admits the dashboard.
LOKI_URL=http://loki.observability.svc.cluster.local:3100

# --- Gatus, for each endpoint's uptime check (internal/checks). A literal until a Project declares it;
#     the observability namespace runs it on the old path.
GATUS_URL=http://gatus.observability.svc.cluster.local

# --- Prometheus, for each Project's health over the last hour (internal/health). A literal until a
#     Project declares it; the observability namespace runs it on the old path.
PROMETHEUS_URL=http://metrics-stack-prometheus.observability.svc.cluster.local:9090

# --- the Release Gate, which serves every gated Application's inputs and record (internal/delivery)
RELEASE_GATE_HOST=${dependency:release-gate.host}
RELEASE_GATE_PORT=${dependency:release-gate.port}

# --- the Estate repository (internal/estate): a token that may read JorisJonkers-dev/estate and
#     nothing else. ESTATE_REPOSITORY and GITHUB_API keep their defaults.
GITHUB_TOKEN=${secret:secret/data/estate-dashboard-system/sign-in#github-token}
